          {
            "type": "color",
            "id": "secondary_foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.secondary_foreground.label",
            "default": "#171717"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.muted.label",
            "default": "#f5f5f5"
          },
          {
            "type": "color",
            "id": "muted_foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.muted_foreground.label",
