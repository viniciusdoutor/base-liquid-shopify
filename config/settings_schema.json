          {
            "type": "color",
            "id": "accent_foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.accent_foreground.label",
            "default": "#171717"
          },
          {
            "type": "color",
            "id": "destructive",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.destructive.label",
