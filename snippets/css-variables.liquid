{%- comment -%}
  ============================================================
  css-variables — variáveis CSS globais do tema
  ============================================================

  O QUE FAZ:
  Gera as CSS custom properties a partir das settings do tema:
  - Um bloco `.color-<scheme id>` por esquema de `settings.color_schemes`
    (18 tokens shadcn + 12 aliases legados retrocompatíveis). O primeiro
    esquema (scheme-1) é combinado com `:root`, então vira o padrão da
    página inteira; os demais só se aplicam dentro de um wrapper com a
    classe correspondente (ex.: `.color-scheme-2`).
  - Um `:root` com `--radius`, `--sale`, tipografia (com @font-face),
    escala de fonte fluida (--f0..--f8) e tokens de layout (largura da
    página, radius por elemento, espaçamento).
  Também define estilos base de body e headings.

  COMO USAR:
  {% render 'css-variables' %}
  Renderize uma única vez, dentro do <head> em theme.liquid.

  PARÂMETROS:
  Nenhum — lê tudo de settings (settings.color_schemes, settings.type_*, etc).

  OBSERVAÇÕES:
  Mantém aliases retrocompatíveis (--color-*, --cor-marca, --cor-verde,
  --cor-gelo, --cor-cinza, --bold...) usados por seções antigas.
  Eles são redeclarados dentro de CADA bloco `.color-<id>` (não só em
  `:root`): uma custom property que guarda `var(--x)` é calculada onde
  foi declarada, então declará-la só em `:root` a congelaria no valor
  do scheme-1 mesmo dentro de um wrapper `.color-scheme-2`. Se remover,
  quebra o CSS dessas seções.
{%- endcomment -%}
{%- liquid
  assign header_font = settings.type_header_font
  assign body_font = settings.type_body_font
  assign header_font_bold = header_font | font_modify: 'weight', 'bold'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
-%}
<style>
  {{ header_font | font_face: font_display: 'swap' }}
  {{ header_font_bold | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  {%- for scheme in settings.color_schemes %}
  {% if forloop.first %}:root, {% endif %}.color-{{ scheme.id }} {
    /* shadcn tokens (CS-04) */
    --background: {{ scheme.settings.background }};
    --foreground: {{ scheme.settings.foreground }};
    --card: {{ scheme.settings.card }};
    --card-foreground: {{ scheme.settings.card_foreground }};
    --popover: {{ scheme.settings.card }};
    --popover-foreground: {{ scheme.settings.card_foreground }};
    --primary: {{ scheme.settings.primary }};
    --primary-foreground: {{ scheme.settings.primary_foreground }};
    --secondary: {{ scheme.settings.secondary }};
    --secondary-foreground: {{ scheme.settings.secondary_foreground }};
    --muted: {{ scheme.settings.muted }};
    --muted-foreground: {{ scheme.settings.muted_foreground }};
    --accent: {{ scheme.settings.accent }};
    --accent-foreground: {{ scheme.settings.accent_foreground }};
    --destructive: {{ scheme.settings.destructive }};
    --border: {{ scheme.settings.border }};
    --input: {{ scheme.settings.input }};
    --ring: {{ scheme.settings.ring }};

    /* Backwards-compatible aliases (LEG-01), scoped per scheme (LEG-02) */
    --color-background: var(--background);
    --color-text: var(--foreground);
    --color-background-contrast: var(--muted);
    --color-text-contrast: var(--foreground);
    --color-accent: var(--primary);
    --color-accent-text: var(--primary-foreground);
    --color-border: var(--border);
    --color-sale: var(--sale);
    --cor-marca: var(--primary);
    --cor-verde: var(--sale);
    --cor-gelo: var(--muted);
    --cor-cinza: var(--border);
  }
  {%- endfor %}

  :root {
    /* Colors */
    --cor-branco: #ffffff;
    --cor-preto: #000000;
    --sale: {{ settings.color_sale }};
    --radius: {{ settings.radius }}px;

    /* Typography */
    --font-heading-family: {{ header_font.family }}, {{ header_font.fallback_families }};
    --font-heading-weight: {{ header_font.weight }};
    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    /* Backwards-compatible font aliases */
    --estilo: var(--font-heading-family);
    --bold: var(--font-body-family);
    --light: var(--font-body-family);

    /* Fluid type scale: clamp(min, Arem + Bvw, max), interpolated between a
       375px and a 1440px viewport so each step keeps its previous min/max. */
    --f0: clamp(0.5rem, calc(0.4296rem + 0.3005vw), 0.7rem);
    --f1: clamp(0.7rem, calc(0.6296rem + 0.3005vw), 0.9rem);
    --f2: clamp(0.9rem, calc(0.8296rem + 0.3005vw), 1.1rem);
    --f3: clamp(1.1rem, calc(1.0296rem + 0.3005vw), 1.3rem);
    --f4: clamp(1.3rem, calc(1.2296rem + 0.3005vw), 1.5rem);
    --f5: clamp(1.5rem, calc(1.3944rem + 0.4507vw), 1.8rem);
    --f6: clamp(1.8rem, calc(1.6592rem + 0.6009vw), 2.2rem);
    --f7: clamp(2.2rem, calc(2.0944rem + 0.4507vw), 2.5rem);
    --f8: clamp(3rem, calc(2.6479rem + 1.5023vw), 4rem);

    /* Layout */
    --page-width: {{ settings.page_width }}px;
    --spacing-sections: {{ settings.spacing_sections }}px;
    --buttons-radius: {{ settings.buttons_radius }}px;
    --inputs-radius: {{ settings.inputs_radius }}px;
    --media-radius: {{ settings.media_radius }}px;
  }

  body {
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    color: var(--color-text);
    background-color: var(--color-background);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
  }
</style>
