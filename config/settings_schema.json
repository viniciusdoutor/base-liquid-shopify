          {
            "type": "color",
            "id": "border",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.border.label",
            "default": "#e5e5e5"
          },
          {
            "type": "color",
            "id": "input",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.input.label",
            "default": "#e5e5e5"
