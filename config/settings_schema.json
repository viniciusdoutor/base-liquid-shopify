          {
            "type": "color",
            "id": "primary_foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.primary_foreground.label",
            "default": "#fafafa"
          },
          {
            "type": "color",
            "id": "secondary",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.secondary.label",
            "default": "#f5f5f5"
