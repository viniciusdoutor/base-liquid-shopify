# Copie para .env e preencha. O .env nunca é commitado.
# Domínio da dev store usada pelo G2 (ex.: minha-loja.myshopify.com)
SHOPIFY_STORE=
# Token do app Theme Access (opcional localmente; usado em CI)
SHOPIFY_CLI_THEME_TOKEN=
# Senha do storefront da dev store (repassada como --store-password)
SHOPIFY_STOREFRONT_PASSWORD=
