{%- comment -%}
  ============================================================
  GIFT CARD — página do vale-presente (HTML completo)
  ============================================================

  O QUE FAZ:
  Página que o cliente vê ao receber um vale-presente. Mostra o saldo,
  o código do cartão, um QR Code (lib vendor/qrcode.js do Shopify),
  botão de copiar, botão de imprimir, link Apple Wallet e
  link para voltar à loja.

  ONDE É USADA:
  Template gift_card (URL do vale-presente emitido).

  PRINCIPAIS PARTES:
  - Documento HTML completo (tem <html>, <head>, <body>) — NÃO é uma
    section OS 2.0; por isso carrega index.css e css-variables direto
  - gift_card.balance / .code / .expired / .pass_url: dados do cartão
  - QR Code: lib oficial 'vendor/qrcode.js' | shopify_asset_url, 120x120,
    a partir de gift_card.qr_identifier (mesmo padrão do Dawn)
  - Botão copiar usa navigator.clipboard; botão imprimir usa window.print()

  OBSERVAÇÕES:
  ATENÇÃO: este cabeçalho fica ANTES do <!doctype html>, como comentário
  Liquid. Se expirado, o saldo aparece riscado com tag "expirado".
  Estilos de .giftcard__actions somem no @media print.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="referrer" content="origin">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <meta name="robots" content="noindex,nofollow">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- assign gift_card_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value, shop: shop.name }}</title>

    {{ 'index.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    {{ content_for_header }}

    <style>
      body {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 24px;
        margin: 0;
      }

      .giftcard {
        width: 100%;
        max-width: 460px;
        text-align: center;
      }

      .giftcard__logo {
        margin-bottom: 24px;
      }

      .giftcard__logo-image {
        max-width: 220px;
        height: auto;
        margin: 0 auto;
        display: block;
      }

      .giftcard__shop-name {
        font-size: var(--f6);
      }

      .giftcard__card {
        position: relative;
        padding: 32px 24px;
        border: 1px solid var(--color-border, #c2c2c2);
        border-radius: var(--media-radius, 8px);
        background-color: var(--color-background-contrast, #f2f3f8);
        margin-bottom: 24px;
      }

      .giftcard__label {
        font-size: var(--f1);
        text-transform: uppercase;
        opacity: 0.6;
        margin-bottom: 8px;
      }

      .giftcard__value {
        font-family: var(--font-heading-family);
        font-size: var(--f8);
        line-height: 1;
        margin-bottom: 4px;
      }

      .giftcard__value--expired {
        text-decoration: line-through;
        opacity: 0.5;
      }

      .giftcard__expired-tag {
        display: inline-block;
        margin-top: 8px;
        padding: 4px 10px;
        font-size: var(--f1);
        color: var(--color-accent-text, #fff);
        background-color: var(--color-sale, #d02e2e);
        border-radius: 4px;
      }

      .giftcard__qr {
        margin: 24px auto 8px;
        width: 160px;
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-background, #fff);
        padding: 8px;
        border-radius: var(--inputs-radius, 4px);
      }

      .giftcard__qr canvas,
      .giftcard__qr img {
        width: 100%;
        height: 100%;
        display: block;
      }

      .giftcard__code-wrap {
        margin-bottom: 20px;
      }

      .giftcard__code {
        display: inline-block;
        padding: 10px 16px;
        font-family: var(--font-body-family);
        font-size: var(--f4);
        letter-spacing: 0.15em;
        border: 1px dashed var(--color-border, #c2c2c2);
        border-radius: var(--inputs-radius, 4px);
        background-color: var(--color-background, #fff);
      }

      .giftcard__actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
      }

      .giftcard__copy {
        background: none;
        border: none;
        color: var(--color-accent);
        text-decoration: underline;
        cursor: pointer;
        font-size: var(--f2);
      }

      .giftcard__wallet {
        display: inline-block;
      }

      .giftcard__wallet img {
        height: 44px;
        width: auto;
        display: block;
      }

      .giftcard__continue {
        margin-top: 8px;
      }

      @media print {
        .giftcard__actions {
          display: none;
        }
      }
    </style>
  </head>

  <body class="template-gift-card">
    <main class="giftcard" role="main">
      <div class="giftcard__logo">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 440
            | image_tag:
              widths: '110, 220, 330, 440',
              class: 'giftcard__logo-image',
              alt: shop.name | escape
          }}
        {%- else -%}
          <h1 class="giftcard__shop-name">{{ shop.name }}</h1>
        {%- endif -%}
      </div>

      <p class="giftcard__subtext">{{ 'gift_cards.issued.subtext' | t }}</p>

      <div class="giftcard__card">
        <p class="giftcard__label">{{ 'gift_cards.issued.subtext' | t }}</p>
        <div class="giftcard__value {% if gift_card.expired %}giftcard__value--expired{% endif %}">
          {{ gift_card.balance | money }}
        </div>
        {%- if gift_card.expired -%}
          <span class="giftcard__expired-tag">{{ 'gift_cards.issued.expired' | t }}</span>
        {%- endif -%}

        <div
          class="giftcard__qr"
          id="QrCode"
          data-identifier="{{ gift_card.qr_identifier }}"
          role="img"
          aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}"
        ></div>
      </div>

      <div class="giftcard__code-wrap">
        <p class="giftcard__label">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
        <span class="giftcard__code" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
      </div>

      <div class="giftcard__actions">
        <button
          type="button"
          class="giftcard__copy"
          id="CopyButton"
          data-code="{{ gift_card.code }}"
          data-success="{{ 'gift_cards.issued.copy_code_success' | t }}"
        >
          {{ 'gift_cards.issued.copy_code' | t }}
        </button>

        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="giftcard__wallet">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              width="120"
              height="44"
            >
          </a>
        {%- endif -%}

        <button type="button" class="button button--secondary" onclick="window.print();">
          {{ 'gift_cards.issued.print_gift_card' | t }}
        </button>

        <a href="{{ shop.url }}" class="button giftcard__continue">
          {{ 'gift_cards.issued.shop_link' | t }}
        </a>
      </div>
    </main>

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      (function () {
        'use strict';
        // vendor/qrcode.js carrega com defer: só existe depois do parse do documento.
        document.addEventListener('DOMContentLoaded', function () {
          var host = document.getElementById('QrCode');
          if (host && host.getAttribute('data-identifier') && window.QRCode) {
            new QRCode(host, {
              text: host.getAttribute('data-identifier'),
              width: 120,
              height: 120,
            });
          }
        });
        var copyBtn = document.getElementById('CopyButton');
        if (copyBtn && navigator.clipboard) {
          copyBtn.addEventListener('click', function () {
            navigator.clipboard.writeText(copyBtn.getAttribute('data-code')).then(function () {
              copyBtn.textContent = copyBtn.getAttribute('data-success');
            });
          });
        }
      })();
    </script>
  </body>
</html>
