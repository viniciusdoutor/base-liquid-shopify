            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.background.label",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.foreground.label",
            "default": "#0a0a0a"
          },
          {
            "type": "color",
            "id": "card",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.card.label",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "card_foreground",
            "label": "t:settings_schema.colors.settings.color_schemes.settings.card_foreground.label",
            "default": "#0a0a0a"
          },
          {
            "type": "color",
